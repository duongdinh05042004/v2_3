# Application
NODE_ENV=development
PORT=3000
APP_NAME=tiktok-bitrix24-integration
API_PREFIX=api/v1
API_KEY=change-me-to-a-strong-random-key

# Database (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USER=tiktok
DB_PASSWORD=tiktok_secret
DB_NAME=tiktok_bitrix24
DB_SYNC=false
DB_LOGGING=false

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# TikTok Lead Generation
TIKTOK_APP_SECRET=tiktok_app_secret_change_me
TIKTOK_ACCESS_TOKEN=mock-tiktok-access-token
TIKTOK_PIXEL_CODE=CXXXXXXXXXXXXXXX
TIKTOK_API_BASE_URL=http://localhost:4001
TIKTOK_WEBHOOK_TOLERANCE_SECONDS=300

# Bitrix24
BITRIX24_WEBHOOK_URL=http://localhost:4002/rest
BITRIX24_WEBHOOK_SECRET=bitrix24_webhook_secret_change_me
BITRIX24_TIMEOUT_MS=10000

# Queue
QUEUE_PREFIX=tb24
LEAD_PROCESS_ATTEMPTS=5
BITRIX_SYNC_ATTEMPTS=5
CONVERSION_SYNC_ATTEMPTS=5

# Rate limiting
THROTTLE_TTL=60
THROTTLE_LIMIT=100
WEBHOOK_THROTTLE_LIMIT=300
EXPORT_THROTTLE_LIMIT=10

# Cache
CACHE_TTL_SECONDS=60
MAPPING_CACHE_TTL_SECONDS=300

# Notifications
NOTIFY_WEBHOOK_URL=
NOTIFY_EMAIL_FROM=crm-alerts@example.com

# Reports
REPORT_CRON=0 8 * * *
ALERT_STALE_LEAD_HOURS=24

# Logging
LOG_LEVEL=info

# CORS (comma-separated). Empty = allow all in development, deny cross-origin in production.
CORS_ORIGINS=http://localhost:3000

# Swagger is on in development, off in production unless explicitly true.
SWAGGER_ENABLED=true

